# ─────────────────────────────────────────────────────────────
# MAREA — environment configuration
# Copy to .env (never commit real values). Every secret is read
# from the environment; nothing is hardcoded in source.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database (MySQL 8.x, InnoDB) ─────────────────────────────
# Use a dedicated least-privilege user, not root.
DATABASE_URL="mysql://marea:change-me@127.0.0.1:3306/marea"
# Separate database used by the integration test suite (it is wiped on each run).
TEST_DATABASE_URL="mysql://marea:change-me@127.0.0.1:3306/marea_test"

# ── API (Express) ────────────────────────────────────────────
API_PORT=4000
# Public origin of the storefront. Used for CORS-free same-origin checks,
# CSRF origin validation and absolute links in emails.
PUBLIC_WEB_URL="http://localhost:3000"
# Comma-separated extra origins allowed to call state-changing endpoints.
TRUSTED_ORIGINS=""
# 32+ random bytes, e.g. `openssl rand -base64 48`. Used for signing guest-cart cookies.
COOKIE_SECRET="replace-with-long-random-string-at-least-32-chars"
# Cookie `Secure` flag; must be true behind HTTPS in staging/production.
COOKIE_SECURE=false
SESSION_TTL_HOURS=336
ADMIN_SESSION_TTL_HOURS=12
LOG_LEVEL=info

# ── Object storage (S3-compatible) ───────────────────────────
# STORAGE_DRIVER=local stores files on disk for development only.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR="./storage"
# Public base URL that serves stored objects: the CDN or bucket URL in production.
# In development use "/media" — the web app proxies it to the API, and Next.js
# image optimisation refuses absolute localhost URLs.
MEDIA_PUBLIC_BASE_URL="/media"
S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=true

# ── Initial administrator (used once by `pnpm db:seed`) ──────
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ── Web (Next.js) ────────────────────────────────────────────
# Internal URL the Next.js server uses to reach the API.
API_INTERNAL_URL="http://127.0.0.1:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Host names Next/Image may optimise (comma-separated), e.g. your CDN.
NEXT_PUBLIC_MEDIA_HOSTS="localhost"

# ── Payments (Phase 7 — leave empty until merchant account is approved) ─
PAYMENT_PROVIDER=""
MONRI_MERCHANT_KEY=""
MONRI_AUTHENTICITY_TOKEN=""
MONRI_ENV="test"

# ── Email ────────────────────────────────────────────────────
# MAIL_DRIVER=log prints e-mails to the API log instead of sending (development only).
MAIL_DRIVER=log
MAIL_FROM="MAREA <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
