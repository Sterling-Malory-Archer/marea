# API (private). Every value here is a secret or environment-specific — never commit api.env.
NODE_ENV=production
API_PORT=4000
DATABASE_URL=mysql://marea:CHANGE_ME@db-host:3306/marea
PUBLIC_WEB_URL=https://www.example.me
TRUSTED_ORIGINS=https://www.example.me
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=
COOKIE_SECURE=true
# same value as in web.env
INTERNAL_API_KEY=
TRUST_PROXY_HOPS=1
RATE_LIMIT_MULTIPLIER=1

STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
# leave empty for AWS; set for other S3-compatible storage
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_BASE_URL=https://media.example.me

MAIL_DRIVER=smtp
MAIL_FROM="MAREA <orders@example.me>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# First launch only (release:seed creates this owner if it doesn't exist; then remove the password from here).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional: alert a chat channel (Slack/Teams/Discord-compatible webhook) on server errors.
ALERT_WEBHOOK_URL=
LOG_LEVEL=info
