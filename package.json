{
  "name": "marea",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @marea/db build && pnpm --filter @marea/api build && pnpm --filter @marea/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @marea/api test",
    "db:generate": "pnpm --filter @marea/db generate",
    "db:migrate": "pnpm --filter @marea/db migrate:dev",
    "db:deploy": "pnpm --filter @marea/db migrate:deploy",
    "db:seed": "pnpm --filter @marea/db seed",
    "db:seed:demo": "pnpm --filter @marea/db seed:demo",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
